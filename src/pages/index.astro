---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WorkCard from '../components/WorkCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { site } from '../data/site';
import { work } from '../data/work';
import { featuredWriting } from '../lib/writing';
const selectedWork = work.filter((entry) => entry.featured).slice(0, 3);
const selectedWriting = featuredWriting(await getCollection('writing'));
---
<BaseLayout title={site.name} description={site.description} includePerson>
  <section class="hero" aria-labelledby="intro-title">
    <p class="eyebrow">xiaonan.co</p>
    <h1 id="intro-title">{site.name}<br /><span>/ {site.alternateName}</span></h1>
    <p class="positioning">{site.positioning}</p>
  </section>
  <section class="home-section" aria-label="Selected work">
    <SectionHeading title="Selected work" href="/work/" linkLabel="All work" />
    {selectedWork.length ? selectedWork.map((entry) => <WorkCard entry={entry} />) : <p class="empty-state">Work notes and case studies will find a home here.</p>}
  </section>
  <section class="home-section" aria-label="Selected writing">
    <SectionHeading title="Selected writing" href="/writing/" linkLabel="All writing" />
    {selectedWriting.length ? selectedWriting.map((entry) => <ArticleCard entry={entry} />) : <p class="empty-state">No published writing yet. Notes will appear here as they’re ready.</p>}
  </section>
  <section class="home-section" aria-label="Current interests">
    <SectionHeading title="Current interests" />
    <ul class="interest-list">{site.interests.map((interest) => <li><h3>{interest.title}</h3><p>{interest.description}</p></li>)}</ul>
  </section>
</BaseLayout>
