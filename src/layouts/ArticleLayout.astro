---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { articleUrl, formatDate, isPublished } from '../lib/writing';
interface Props { entry: CollectionEntry<'writing'>; }
const { entry } = Astro.props;
const { data } = entry;
const preview = !isPublished(entry);
---
<BaseLayout title={data.title} description={data.description} canonical={articleUrl(entry)} type="article" noindex={preview} publishedAt={data.publishedAt} updatedAt={data.updatedAt}>
  <article class="article">
    {preview && <aside class="preview-notice"><strong>{data.draft ? 'Draft preview' : 'Scheduled preview'}</strong><br />Visible in local development only. This article is not published.</aside>}
    <header class="article-header">
      <p class="eyebrow">Writing</p><h1>{data.title}</h1><p class="description">{data.description}</p>
      <div class="row-meta"><span>{preview ? 'Publication date' : 'Published'} <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time></span>{data.updatedAt && <span>Updated <time datetime={data.updatedAt.toISOString()}>{formatDate(data.updatedAt)}</time></span>}</div>
      {data.tags.length > 0 && <ul class="tags" aria-label="Topics">{data.tags.map((tag) => <li>{tag}</li>)}</ul>}
    </header>
    <div class="prose"><slot /></div>
    <p class="article-return"><a href="/writing/">← Back to writing</a></p>
  </article>
</BaseLayout>
